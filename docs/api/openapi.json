    "/api/v1/sessions/{session_id}/runs/stream": {
      "post": {
        "summary": "Stream Run",
        "operationId": "stream_run_api_v1_sessions__session_id__runs_stream_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "x-demo-session-token",
            "in": "header",
            "required": true,
            "description": "会话凭据",
            "schema": {
              "type": "string"
            }
