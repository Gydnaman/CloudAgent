        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "message": {
                    "description": "用户消息；NFC 规范化并裁剪后须为 1 至 4,000 个码点",
                    "title": "Message",
                    "type": "string"
                  }
                },
                "required": [
                  "message"
                ],
                "title": "RunInput",
                "type": "object"
              },
              "example": {
                "message": "产品支持哪些部署版本？"
              }
            }
