{
  "name": "cloudagent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "gen:types": "openapi-typescript ../docs/api/openapi.json -o src/api/openapi.gen.ts",
    "lint": "eslint src vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build --configLoader runner",
    "test": "node --test tests/*.test.mjs",
    "test:sse": "node --test tests/sse.test.mjs"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.1.5",
    "vue-tsc": "^3.1.0"
  }
}
